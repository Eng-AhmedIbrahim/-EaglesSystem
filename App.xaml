<Application x:Class="EaglesResort.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:EaglesResort.Helpers"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="BlueGrey" SecondaryColor="Amber"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

                        <!-- Global Converters -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:ChaletStatusToColorConverter x:Key="StatusColor"/>
            <helpers:ChaletStatusToArabicConverter x:Key="StatusArabic"/>
            <helpers:ChaletStatusToArabicConverter x:Key="ChaletStatusToArabic"/>
            <helpers:BookingStatusToArabicConverter x:Key="BookingStatusArabic"/>
            <helpers:BookingStatusToColorConverter x:Key="BookingStatusColor"/>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Global Font and Sharp ClearType Rendering -->
            <Style TargetType="Window">
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
            </Style>

            <Style TargetType="Page">
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
            </Style>

            <Style TargetType="Control">
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
            </Style>

            <!-- Custom Colors -->
            <SolidColorBrush x:Key="PrimaryDark" Color="#0F1923"/>
            <SolidColorBrush x:Key="PrimaryMid" Color="#1A2533"/>
            <SolidColorBrush x:Key="PrimaryLight" Color="#243447"/>
            <SolidColorBrush x:Key="AccentGold" Color="#D4A017"/>
            <SolidColorBrush x:Key="AccentGoldLight" Color="#F0C040"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F0F4F8"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SuccessGreen" Color="#22C55E"/>
            <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
            <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
            <SolidColorBrush x:Key="InfoBlue" Color="#3B82F6"/>

            <!-- Font Size -->
            <system:Double x:Key="FontSizeSmall" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
            <system:Double x:Key="FontSizeNormal" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
            <system:Double x:Key="FontSizeLarge" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
            <system:Double x:Key="FontSizeXL" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
            <system:Double x:Key="FontSizeXXL" xmlns:system="clr-namespace:System;assembly=mscorlib">28</system:Double>

            <!-- Card Style -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button Style -->
            <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource AccentGold}"/>
                <Setter Property="Foreground" Value="#0F1923"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <!-- Danger Button -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            </Style>

            <!-- Success Button -->
            <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            </Style>

            <!-- DataGrid Style -->
            <Style x:Key="ModernDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#2D3F55"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="#1E2D3D"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
            </Style>

            <!-- Stat Card Style -->
            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
