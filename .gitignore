## .NET / C# gitignore

# Build output
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.nuspec
.nuget/
packages/
!**/packages/repositories.config

# Visual Studio
.vs/
*.ncb
*.opendb
*.VC.db
*.VC.VC.opendb

# Rider / JetBrains
.idea/

# Publish profiles
**/Properties/PublishProfiles/

# Logs
*.log
*.txt.bak

# SQLite databases (avoid committing local DB data)
*.db
*.db-shm
*.db-wal

# User secrets
secrets.json
appsettings.Development.json
