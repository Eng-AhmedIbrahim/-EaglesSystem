<Window x:Class="EaglesResort.Views.Dialogs.PaymentDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:EaglesResort.Helpers"
        Title="تفاصيل الفاتورة"
        Width="980" Height="700"
        MinWidth="880" MinHeight="600"
        WindowStyle="None"
        Background="#0F1923"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="B2V"/>

        <!-- صف تفاصيل داخل بطاقة الحساب -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0F1923">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="#0A1420" Padding="22,16"
                BorderBrush="#243447" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#D4A017" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="ReceiptTextCheckOutline" Width="27" Height="27"
                                             Foreground="#0A1420" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="تفاصيل الفاتورة" FontSize="21" FontWeight="Bold" Foreground="#D4A017"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="#162536" CornerRadius="6" Padding="10,3" BorderBrush="#D4A017" BorderThickness="1">
                            <TextBlock Text="{Binding InvoiceNumberDisplay}" FontSize="13" FontWeight="Bold"
                                       Foreground="#F0F4F8" FlowDirection="LeftToRight"/>
                        </Border>
                        <TextBlock Text="{Binding InvoiceDate, StringFormat={}{0:dd/MM/yyyy  -  hh:mm tt}}"
                                   FontSize="12" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource MaterialDesignIconButton}"
                        Width="40" Height="40" ToolTip="إغلاق" VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Foreground="#EF4444"/>
                </Button>
            </Grid>
        </Border>

        <!-- ===== BODY ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18" PanningMode="VerticalOnly">
            <StackPanel>

                <!-- ===== حالة الفاتورة (معدلة / ملغية) ===== -->
                <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}"
                        BorderThickness="2" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                        Visibility="{Binding HasStatus, Converter={StaticResource B2V}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                Background="{Binding StatusBorder}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24"
                                                     Foreground="White" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding StatusForeground}"/>
                            <TextBlock Text="{Binding StatusDetails}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{Binding StatusForeground}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- بيانات النزيل -->
                <Border Background="#162536" CornerRadius="12" Padding="18,15" BorderBrush="#243447" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#1E3A5F"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="Account" Width="30" Height="30" Foreground="#60A5FA"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Booking.GuestName, FallbackValue='—'}" FontSize="19"
                                       FontWeight="Bold" Foreground="#F0F4F8" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Foreground="#64748B"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Booking.PhoneNumber, FallbackValue='—'}" FontSize="13"
                                           Foreground="#94A3B8" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="HomeModern" Width="14" Height="14" Foreground="#60A5FA"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ChaletsSummary, FallbackValue='—'}" FontSize="13"
                                           Foreground="#60A5FA" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- فترة الإقامة -->
                        <Border Grid.Column="2" Background="#111E2B" CornerRadius="10" Padding="14,10"
                                BorderBrush="#2D3F55" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="الوصول" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Booking.CheckInDate, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontSize="13" FontWeight="Bold" Foreground="#22C55E" FlowDirection="LeftToRight"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="المغادرة" FontSize="11"
                                           Foreground="#64748B" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Booking.CheckOutDate, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontSize="13" FontWeight="Bold" Foreground="#EF4444" FlowDirection="LeftToRight"/>

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="1" Background="#2D3F55" Margin="14,0"/>
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="عدد الأيام" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Booking.NumberOfDays, FallbackValue='—'}" FontSize="20"
                                               FontWeight="Bold" Foreground="#D4A017" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ملخص سريع -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#162536" CornerRadius="10" Padding="14,10"
                            BorderBrush="#243447" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="إجمالي الفاتورة" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0} ج.م}" FontSize="19"
                                       FontWeight="Bold" Foreground="#F0F4F8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#14261A" CornerRadius="10" Padding="14,10"
                            BorderBrush="#22C55E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="إجمالي المسدد" FontSize="12" Foreground="#86EFAC"/>
                            <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:N0} ج.م}" FontSize="19"
                                       FontWeight="Bold" Foreground="#22C55E" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#2A1414" CornerRadius="10" Padding="14,10"
                            BorderBrush="#EF4444" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المتبقي المطلوب" FontSize="12" Foreground="#FCA5A5"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0} ج.م}" FontSize="19"
                                       FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- تفاصيل الحساب + طرق الدفع -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- تفاصيل الحساب -->
                    <Border Grid.Column="0" Background="#111E2B" CornerRadius="12" Padding="18,14"
                            BorderBrush="#243447" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CalculatorVariant" Width="19" Height="19"
                                                         Foreground="#D4A017" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="تفاصيل الحساب" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="إجمالي الإقامة (السكن)" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ChaletTotal, StringFormat={}{0:N0} ج.م}" Style="{StaticResource DetailValue}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="إجمالي الوجبات" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MealsTotal, StringFormat={}{0:N0} ج.م}" Style="{StaticResource DetailValue}" Foreground="#22C55E"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="خدمات إضافية" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ExtraServices, StringFormat={}{0:N0} ج.م}" Style="{StaticResource DetailValue}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="التأمين المسترد" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Insurance, StringFormat={}{0:N0} ج.م}" Style="{StaticResource DetailValue}" Foreground="#F59E0B"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="عربون مدفوع (ديبوزت)" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Deposit, StringFormat={}-{0:N0} ج.م}" Style="{StaticResource DetailValue}" Foreground="#EF4444"/>
                            </Grid>

                            <Border Height="1" Background="#243447" Margin="0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="الإجمالي قبل العربون" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:N0} ج.م}" FontSize="16"
                                           FontWeight="Bold" Foreground="#F0F4F8" FlowDirection="LeftToRight"/>
                            </Grid>

                            <Border Background="#14261A" CornerRadius="8" Padding="14,10" Margin="0,10,0,0"
                                    BorderBrush="#22C55E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="المطلوب بعد العربون" Foreground="#86EFAC" FontWeight="Bold"
                                               FontSize="13.5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAfterDeposit, StringFormat={}{0:N0} ج.م}"
                                               Foreground="#22C55E" FontWeight="Bold" FontSize="19" FlowDirection="LeftToRight"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- طرق الدفع -->
                    <Border Grid.Column="2" Background="#111E2B" CornerRadius="12" Padding="18,14"
                            BorderBrush="#D4A017" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Wallet" Width="19" Height="19"
                                                         Foreground="#D4A017" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="تفصيل طرق الدفع والسداد" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#162536" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Foreground="#22C55E" Margin="0,0,6,0"/>
                                            <TextBlock Text="كاش" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CashCombined, StringFormat={}{0:N0} ج.م}" FontSize="17"
                                                   FontWeight="Bold" Foreground="#22C55E" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Background="#162536" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CreditCard" Width="18" Height="18" Foreground="#60A5FA" Margin="0,0,6,0"/>
                                            <TextBlock Text="فيزا / ماستركارد" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding VisaCombined, StringFormat={}{0:N0} ج.م}" FontSize="17"
                                                   FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Background="#162536" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CellphoneNfc" Width="18" Height="18" Foreground="#A78BFA" Margin="0,0,6,0"/>
                                            <TextBlock Text="انستا باي" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstaPayCombined, StringFormat={}{0:N0} ج.م}" FontSize="17"
                                                   FontWeight="Bold" Foreground="#A78BFA" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="2" Background="#162536" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BankTransfer" Width="18" Height="18" Foreground="#F59E0B" Margin="0,0,6,0"/>
                                            <TextBlock Text="تحويل بنكي" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BankTransferCombined, StringFormat={}{0:N0} ج.م}" FontSize="17"
                                                   FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#162536" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PaymentDetails}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentDetails}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PaymentDetails}" FontSize="11.5" Foreground="#94A3B8"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== سجل الحركات على الفاتورة ===== -->
                <Border Background="#162536" CornerRadius="12" Padding="18,15" BorderBrush="#243447"
                        BorderThickness="1" Margin="0,14,0,0"
                        Visibility="{Binding HasActionLogs, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#D4A017"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="سجل الحركات على الفاتورة" FontSize="14" FontWeight="Bold"
                                       Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ActionLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111E2B" CornerRadius="8" Padding="12,9" Margin="0,0,0,7"
                                            BorderBrush="#243447" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D4A017"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActionTitle}" FontSize="13"
                                                               FontWeight="Bold" Foreground="#F0F4F8"/>
                                                    <TextBlock Text="{Binding PerformedBy, StringFormat={} — {0}}"
                                                               FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PerformedAtDisplay, StringFormat={}  •  {0}}"
                                                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#CBD5E1"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="#FDE047" Margin="0,12,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== FOOTER BUTTONS ===== -->
        <Border Grid.Row="2" Background="#0A1420" Padding="22,14"
                BorderBrush="#243447" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- تعديل الفاتورة - للأدمن فقط -->
                <Button x:Name="EditInvoiceButton" Grid.Column="0" Click="EditInvoice_Click"
                        Style="{StaticResource GoldButton}" Height="42" Padding="20,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تعديل الفاتورة" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="Print_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#60A5FA" BorderBrush="#3B82F6" Height="42" Padding="20,0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة الفاتورة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Close_Click" Background="#243447" Foreground="White" BorderThickness="0"
                            Height="42" Padding="26,0" Cursor="Hand">
                        <TextBlock Text="إغلاق" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
