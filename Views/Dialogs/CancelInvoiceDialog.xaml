<Window x:Class="EaglesResort.Views.Dialogs.CancelInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إلغاء الفاتورة"
        Width="560" Height="500"
        WindowStyle="None"
        Background="#0F1923"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Tahoma, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Background="#0F1923">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#2A1414" Padding="20,14" BorderBrush="#7F1D1D" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EF4444" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="Cancel" Width="24" Height="24" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="إلغاء الفاتورة" FontSize="19" FontWeight="Bold" Foreground="#FCA5A5"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#FCA5A5" Opacity="0.85" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Click="Back_Click" Style="{StaticResource MaterialDesignIconButton}"
                        Width="36" Height="36" ToolTip="إغلاق">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#FCA5A5"/>
                </Button>
            </Grid>
        </Border>

        <!-- BODY -->
        <StackPanel Grid.Row="1" Margin="22,18">
            <Border Background="#2A1414" CornerRadius="8" Padding="14,10" BorderBrush="#7F1D1D" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FECACA"
                           Text="سيتم إلغاء الفاتورة وكل الحجوزات المرتبطة بها، وإتاحة الشاليهات مرة أخرى. لا يمكن التراجع عن هذه الخطوة."/>
            </Border>

            <TextBlock Text="اسم من قام بالإلغاء (إلزامي)" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,14,0,6"/>
            <TextBox x:Name="CancelledByBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="اكتب اسم من قام بإلغاء الفاتورة..."
                     Background="#162536" Foreground="#F0F4F8" FontWeight="SemiBold"
                     TextChanged="CancelledByBox_TextChanged"/>

            <TextBlock Text="سبب الإلغاء (مطلوب)" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,14,0,6"/>
            <TextBox x:Name="ReasonBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="اكتب سبب إلغاء الفاتورة..."
                     Background="#162536" Foreground="#F0F4F8"
                     MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="ReasonBox_TextChanged"/>

            <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#0A1420" Padding="20,14" BorderBrush="#243447" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Click="Confirm_Click" Height="42" Padding="22,0" Margin="0,0,10,0"
                        Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تأكيد الإلغاء" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Back_Click" Height="42" Padding="22,0"
                        Background="#243447" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="رجوع" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
