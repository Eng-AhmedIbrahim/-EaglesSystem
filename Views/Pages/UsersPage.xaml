<Page x:Class="EaglesResort.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="UsersPage">

    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="#0D1B2A" Padding="32" Width="440" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold"
                               Foreground="#D4A017" Margin="0,0,0,24"/>

                    <TextBlock Text="اسم المستخدم (Username)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditingUser.Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16"/>

                    <TextBlock Text="الاسم الكامل" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditingUser.FullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16"/>

                    <TextBlock Text="كلمة المرور" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditingUser.PasswordHash, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16"/>

                    <TextBlock Text="الصلاحية" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding SaveUserCommand}"
                                Style="{StaticResource GoldButton}">حفظ</Button>
                        <Button Grid.Column="2" Command="{Binding CancelDialogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#94A3B8" BorderBrush="#2D3F55">إلغاء</Button>
                    </Grid>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="إدارة المستخدمين والصلاحيات" FontSize="24" FontWeight="Bold"
                           Foreground="#F0F4F8" VerticalAlignment="Center" Margin="171,0,-4,0" Grid.ColumnSpan="2"/>

                <Button Command="{Binding AddUserCommand}" Style="{StaticResource GoldButton}" Margin="-14,0,306,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="إضافة مستخدم جديد"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Users Table -->
            <Border Grid.Row="1" Background="#1A2533" CornerRadius="12" Padding="12">
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          HeadersVisibility="Column"
                          RowBackground="#1A2533" AlternatingRowBackground="#0F1923"
                          Foreground="#F0F4F8">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#243447"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#2D3F55"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="180"/>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="الصلاحية" Binding="{Binding Role}" Width="120"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#3B82F6" BorderBrush="Transparent" Padding="6" Margin="0,0,4,0"
                                                ToolTip="تعديل">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#EF4444" BorderBrush="Transparent" Padding="6"
                                                ToolTip="حذف">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Page>
