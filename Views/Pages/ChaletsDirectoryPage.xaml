<Page x:Class="EaglesResort.Views.Pages.ChaletsDirectoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:helpers="clr-namespace:EaglesResort.Helpers"
      Title="Chalets Directory"
      Background="#111E2B"
      FlowDirection="RightToLeft"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      FontFamily="Segoe UI, Tahoma, Arial">

    <Page.Resources>
        <helpers:ChaletStatusToColorConverter x:Key="StatusColor"/>
        <helpers:ChaletStatusToArabicConverter x:Key="StatusArabic"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="#111E2B" Padding="24" CornerRadius="8" Width="400">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="#D4A017" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="رقم الشاليه *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditingChalet.Number, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,12"/>

                    <TextBlock Text="المبنى / المنطقة" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditingChalet.BuildingArea, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,12"/>

                    <TextBlock Text="نوع الشاليه *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AllChaletTypes}" SelectedItem="{Binding EditingChalet.ChaletType}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عدد الغرف" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingChalet.RoomsCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="#F0F4F8" Background="#1A2533"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="السعة القصوى" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingChalet.MaxCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="#F0F4F8" Background="#1A2533"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ملاحظات" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditingChalet.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,24" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#94A3B8" BorderBrush="#94A3B8" Margin="0,0,12,0"/>
                        <Button Command="{Binding SaveChaletCommand}" Content="حفظ البيانات" Style="{StaticResource GoldButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,12,0"
                             materialDesign:HintAssist.Hint="🔍 بحث برقم أو نوع الشاليه..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="#F0F4F8" Background="#1A2533" FontSize="13"/>

                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                              materialDesign:HintAssist.Hint="المبنى"
                              ItemsSource="{Binding Buildings}"
                              SelectedItem="{Binding FilterBuilding}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#F0F4F8"/>

                    <ComboBox Grid.Column="2" Margin="0,0,8,0"
                              materialDesign:HintAssist.Hint="النوع"
                              ItemsSource="{Binding ChaletTypes}"
                              SelectedItem="{Binding FilterType}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#F0F4F8"/>

                    <ComboBox Grid.Column="3" Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="الحالة"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding FilterStatus}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#F0F4F8"/>

                    <Button Grid.Column="4" Command="{Binding AddChaletCommand}"
                            Style="{StaticResource GoldButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة شاليه"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Chalets DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding FilteredChalets}"
                          SelectedItem="{Binding SelectedChalet}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" CanUserAddRows="False"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الشاليه" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="المبنى / المنطقة" Binding="{Binding BuildingArea}" Width="120"/>
                        <DataGridTextColumn Header="نوع الشاليه" Binding="{Binding ChaletType}" Width="*"/>
                        <DataGridTextColumn Header="عدد الغرف" Binding="{Binding RoomsCount}" Width="80"/>
                        <DataGridTextColumn Header="السعة القصوى" Binding="{Binding MaxCapacity}" Width="90"/>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="الحالة الحالية" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusColor}}"
                                            CornerRadius="6" Padding="8,3" Margin="4,2">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusArabic}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="إجراءات" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <Button Content="✏️ تعديل" Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditChaletCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GoldButton}" FontSize="10" Padding="6,3"/>

                                        <Button Content="حجز جديد" Margin="0,0,4,0"
                                                Command="{Binding DataContext.NewBookingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SuccessButton}" FontSize="10" Padding="6,3"/>

                                        <Button Content="تغيير الحالة"
                                                Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#F59E0B" BorderBrush="#F59E0B"
                                                FontSize="10" Padding="6,3"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Page>
