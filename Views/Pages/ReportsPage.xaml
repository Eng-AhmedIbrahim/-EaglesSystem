<Page x:Class="EaglesResort.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="التقارير"
      Background="#111E2B"
      FlowDirection="RightToLeft"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      FontFamily="Segoe UI, Tahoma, Arial">

    <Page.Resources>
        <Style x:Key="ReportTile" TargetType="Border">
            <Setter Property="Background" Value="#162536"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#243447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ReportTileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ReportTileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#243447"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2D3F55"/>
        </Style>

        <Style x:Key="ReportGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#1A2533"/>
            <Setter Property="AlternatingRowBackground" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Background="#3A2E10" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="ChartBar" Width="26" Height="26" Foreground="#D4A017"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="التقارير والإحصائيات" FontSize="23" FontWeight="Bold" Foreground="#F0F4F8"/>
                    <TextBlock Text="تقارير الفواتير والإيرادات والإشغال وسجل حركات الفواتير"
                               FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Tabs ===== -->
        <TabControl Grid.Row="1" Background="Transparent" Foreground="#F0F4F8"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                </Style>
            </TabControl.Resources>

            <!-- ================= TAB 1: الفواتير ================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ReceiptText" Width="18" Height="18"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تقرير الفواتير والإيرادات"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Background="#0F1923" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- الفلاتر -->
                    <Border Grid.Row="0" Background="#162536" CornerRadius="10" Padding="14,10"
                            BorderBrush="#243447" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="من" VerticalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="13" Margin="0,0,8,0"/>
                            <DatePicker x:Name="InvoicesFromPicker" Grid.Column="1" Width="150"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="إلى" VerticalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="13" Margin="0,0,8,0"/>
                            <DatePicker x:Name="InvoicesToPicker" Grid.Column="3" Width="150"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button Grid.Column="5" Click="LoadInvoices_Click" Style="{StaticResource GoldButton}"
                                    Height="38" Padding="18,0" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="عرض التقرير" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="6" Click="ExportInvoices_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="38" Padding="18,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تصدير Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- المؤشرات -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,12,0,12">
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="عدد الفواتير" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="InvCountText" Style="{StaticResource ReportTileValue}" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="إجمالي الفواتير" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="InvTotalText" Style="{StaticResource ReportTileValue}" Foreground="#D4A017"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="المحصّل" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="InvPaidText" Style="{StaticResource ReportTileValue}" Foreground="#22C55E"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="المتبقي" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="InvRemainingText" Style="{StaticResource ReportTileValue}" Foreground="#F87171"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="فواتير ملغية" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="InvCancelledText" Style="{StaticResource ReportTileValue}" Foreground="#FBBF24"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- الجدول -->
                    <Border Grid.Row="2" Background="#1A2533" CornerRadius="10" Padding="0">
                        <DataGrid x:Name="InvoicesGrid" Style="{StaticResource ReportGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="اسم النزيل" Binding="{Binding GuestName}" Width="*"/>
                                <DataGridTextColumn Header="الشاليهات" Binding="{Binding Chalets}" Width="140"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat={}{0:N0} ج.م}" Width="115">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding Paid, StringFormat={}{0:N0} ج.م}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#22C55E"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat={}{0:N0} ج.م}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#F87171"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: الإشغال ================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HomeCity" Width="18" Height="18"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تقرير الإشغال والشاليهات"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Background="#0F1923" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#162536" CornerRadius="10" Padding="14,10"
                            BorderBrush="#243447" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="حالة الشاليهات الآن حسب بيانات الحجوزات النشطة"
                                       VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>

                            <Button Grid.Column="1" Click="LoadOccupancy_Click" Style="{StaticResource GoldButton}"
                                    Height="38" Padding="18,0" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Click="ExportOccupancy_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="38" Padding="18,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تصدير Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,12,0,12">
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="إجمالي الشاليهات" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="OccTotalText" Style="{StaticResource ReportTileValue}" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="متاح" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="OccAvailableText" Style="{StaticResource ReportTileValue}" Foreground="#22C55E"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="مسكون" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="OccOccupiedText" Style="{StaticResource ReportTileValue}" Foreground="#F87171"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}">
                            <StackPanel>
                                <TextBlock Text="تحت الصيانة" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="OccMaintenanceText" Style="{StaticResource ReportTileValue}" Foreground="#FBBF24"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ReportTile}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="تحت النظافة" Style="{StaticResource ReportTileLabel}"/>
                                <TextBlock x:Name="OccCleaningText" Style="{StaticResource ReportTileValue}" Foreground="#A78BFA"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#1A2533" CornerRadius="10" Padding="0">
                        <DataGrid x:Name="OccupancyGrid" Style="{StaticResource ReportGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الشاليه" Binding="{Binding Number}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبنى" Binding="{Binding Building}" Width="130"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding ChaletType}" Width="100"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="النزيل الحالي" Binding="{Binding GuestName}" Width="*"/>
                                <DataGridTextColumn Header="الوصول" Binding="{Binding CheckIn}" Width="110"/>
                                <DataGridTextColumn Header="المغادرة" Binding="{Binding CheckOut}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: سجل الحركات ================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="سجل حركات الفواتير"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Background="#0F1923" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#162536" CornerRadius="10" Padding="14,10"
                            BorderBrush="#243447" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="من" VerticalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="13" Margin="0,0,8,0"/>
                            <DatePicker x:Name="LogsFromPicker" Grid.Column="1" Width="150"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="إلى" VerticalAlignment="Center"
                                       Foreground="#94A3B8" FontSize="13" Margin="0,0,8,0"/>
                            <DatePicker x:Name="LogsToPicker" Grid.Column="3" Width="150"
                                        VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button Grid.Column="5" Click="LoadLogs_Click" Style="{StaticResource GoldButton}"
                                    Height="38" Padding="18,0" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="عرض" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="6" Click="ExportLogs_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="38" Padding="18,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="17" Height="17"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تصدير Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#1A2533" CornerRadius="10" Padding="0" Margin="0,12,0,0">
                        <DataGrid x:Name="LogsGrid" Style="{StaticResource ReportGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding PerformedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الحركة" Binding="{Binding ActionTitle}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#D4A017"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="بواسطة" Binding="{Binding PerformedBy}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
