<Page x:Class="EaglesResort.Views.Pages.ReservationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:helpers="clr-namespace:EaglesResort.Helpers"
      Title="ReservationsPage"
      Language="ar-EG"
      Background="#111E2B"
      FlowDirection="RightToLeft"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      FontFamily="Segoe UI, Tahoma, Arial">

    <Page.Resources>
        <helpers:BookingStatusToColorConverter x:Key="BookingStatusColor"/>
        <helpers:BookingStatusToArabicConverter x:Key="BookingStatusArabic"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab Button Style with Active State Indicator -->
        <Style x:Key="FilterTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2D3D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3F55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions Bar -->
        <Border Grid.Row="0" Background="#162536" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#2D3F55" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="26" Height="26" Foreground="#D4A017" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="سجل الحجوزات المسبقة والعربون" FontSize="22" FontWeight="Bold" Foreground="#F0F4F8" VerticalAlignment="Center"/>
                        
                        <!-- Badges -->
                        <Border Background="#1E3A5F" CornerRadius="10" Padding="10,3" Margin="14,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpcomingCount, StringFormat=قادمة: {0}}" FontSize="12" Foreground="#60A5FA" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1E2D3D" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TodayCount, StringFormat=وصول اليوم: {0}}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#14532D" CornerRadius="10" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CheckedInCount, StringFormat=تم تسكينهم: {0}}" FontSize="12" Foreground="#4ADE80" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount, StringFormat=الإجمالي: {0}}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="جدول خاص بالحجوزات المسبقة، إدارة مبالغ وإيصالات العربون (الديبوزت)، وتسجيل توقيت الحجز باليوم والساعة تلقائياً" FontSize="12.5" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- New Booking Button -->
                <Button Grid.Column="1" Command="{Binding OpenNewReservationCommand}"
                        Style="{StaticResource GoldButton}" Height="46" Padding="20,0" VerticalAlignment="Center" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarPlus" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="➕ إضافة حجز مسبق جديد" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Search & Filters Bar -->
        <Border Grid.Row="1" Background="#162536" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="#2D3F55" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <!-- Search Input and Date Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="بحث باسم العميل، الهاتف، أو الشاليه..."
                             Foreground="#F0F4F8" Background="#111E2B" Height="50" Width="250" FontSize="13"/>
                    <DatePicker SelectedDate="{Binding FilterDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Language="ar-EG"
                                materialDesign:HintAssist.Hint="فلتر بيوم محدد..."
                                Foreground="#F0F4F8" Background="#111E2B" Height="50" Width="190" Margin="10,0,0,0" FontSize="13"/>
                    <Button Command="{Binding ClearDateFilterCommand}"
                            Visibility="{Binding FilterDate, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource MaterialDesignToolButton}"
                             Foreground="#EF4444" Padding="4" Height="28" Width="28" Margin="4,0,0,0" ToolTip="إلغاء فلتر التاريخ">
                        <materialDesign:PackIcon Kind="CloseCircle" Width="18" Height="18"/>
                    </Button>
                </StackPanel>

                <!-- Interactive Filter Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Tab 0: الحجوزات القادمة (الافتراضي) -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilter}" Value="0">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="⏳ الحجوزات القادمة" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding UpcomingCount}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 1: وصول اليوم -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilter}" Value="1">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="📅 وصول اليوم" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding TodayCount}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: تم تسكينهم -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilter}" Value="2">
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🏨 تم تسكينهم" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding CheckedInCount}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 3: كل الحجوزات المسبقة -->
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="3" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilter}" Value="3">
                                        <Setter Property="Background" Value="#4B5563"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="📁 كل الحجوزات المسبقة" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Reservations DataGrid -->
        <Border Grid.Row="2" Background="#162536" CornerRadius="12" Padding="12" BorderBrush="#2D3F55" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Reservations}" Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.PanningMode="VerticalOnly">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>

                    <!-- Date & Time of Booking (يسحب التاريخ والوقت اللي حجز فيه لوحده) -->
                    <DataGridTemplateColumn Header="تاريخ ووقت الحجز" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" Foreground="#F0F4F8" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:hh:mm tt}}" Foreground="#38BDF8" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Guest Info -->
                    <DataGridTemplateColumn Header="العميل" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GuestName}" FontWeight="Bold" Foreground="#F0F4F8" FontSize="13" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Phones -->
                    <DataGridTemplateColumn Header="أرقام الهاتف" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PhoneNumber}" Foreground="#38BDF8" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SecondaryPhoneNumber}" Foreground="#94A3B8" FontSize="11"
                                               Visibility="{Binding SecondaryPhoneNumber.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Chalet -->
                    <DataGridTemplateColumn Header="الشاليه" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1E2D3D" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <TextBlock Text="{Binding Chalet.Number, StringFormat=({0})}" FontWeight="Bold" Foreground="#60A5FA" FontSize="13"/>
                                        <TextBlock Text="{Binding Chalet.ChaletType}" FontSize="11" Foreground="#94A3B8" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الوصول" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="المغادرة" Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="المدة" Binding="{Binding NumberOfDays, StringFormat={}{0} يوم}" Width="65"/>

                    <DataGridTextColumn Header="إجمالي السكن" Binding="{Binding ChaletTotal, StringFormat={}{0:N0} ج.م}" Width="100"/>

                    <!-- Deposit Column with Receipt Preview -->
                    <DataGridTemplateColumn Header="العربون (الديبوزت)" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Deposit, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" Foreground="#22C55E" FontSize="12.5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DepositDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Command="{Binding DataContext.ViewDepositReceiptCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DepositReceiptImagePath.Length, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#38BDF8" BorderBrush="#38BDF8" Padding="4" Height="26" Width="26" ToolTip="معاينة صورة الإيصال">
                                        <materialDesign:PackIcon Kind="ReceiptText" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="الحالة" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource BookingStatusColor}}"
                                        CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource BookingStatusArabic}}"
                                               FontSize="11.5" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 1. استكمال الحجز (تسكين وفاتورة) -->
                                    <Button Command="{Binding DataContext.CheckInAndInvoiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#10B981" Foreground="White" BorderThickness="0"
                                            Padding="8,4" FontSize="11.5" Margin="0,0,5,0" Cursor="Hand" ToolTip="استكمال الحجز وتسكين النزيل وإصدار الفاتورة مع خصم العربون">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#059669"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarCheck" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="استكمال الحجز" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. تعديل الحجز -->
                                    <Button Command="{Binding DataContext.OpenEditReservationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="#2563EB" Foreground="White" BorderThickness="0"
                                            Padding="8,4" FontSize="11.5" Margin="0,0,5,0" Cursor="Hand" ToolTip="تعديل بيانات الحجز المسبق والتواريخ">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="تعديل الحجز" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. تغيير الشاليه -->
                                    <Button Command="{Binding DataContext.OpenChangeChaletCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#38BDF8" BorderBrush="#38BDF8"
                                            Padding="6,4" Height="28" Width="28" Margin="0,0,4,0" ToolTip="تغيير الشاليه لهذا الحجز المسبق">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14"/>
                                    </Button>

                                    <!-- 4. إلغاء الحجز -->
                                    <Button Command="{Binding DataContext.CancelReservationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="6,4" Height="28" Width="28" ToolTip="إلغاء الحجز المسبق">
                                        <materialDesign:PackIcon Kind="Cancel" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= FULL-SCREEN OVERLAYS (Centered on entire Page) ================= -->

        <!-- OVERLAY 1: NEW RESERVATION MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000" Background="#D9000000"
              Visibility="{Binding IsNewReservationOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#162536" CornerRadius="16" BorderBrush="#D4A017" BorderThickness="2"
                    Width="760" MaxHeight="780" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" CanContentScroll="False">
                    <StackPanel>
                        <!-- Modal Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="#D4A017" CornerRadius="8" Padding="7" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CalendarPlus" Width="24" Height="24" Foreground="#0A1420"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إضافة حجز مسبق جديد" FontSize="21" FontWeight="Bold" Foreground="#D4A017"/>
                                <TextBlock Text="تسجيل بيانات العميل والشاليه ومقدم العربون (الديبوزت)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 1. Guest Name & Primary Phone -->
                        <TextBlock Text="بيانات العميل الأساسية:" Foreground="#CBD5E1" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewGuestName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="اسم العميل *"
                                     Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0" FontSize="13"/>
                            <TextBox Grid.Column="1" Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="رقم الهاتف الأساسي *"
                                     Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0" FontSize="13"/>
                        </Grid>

                        <!-- 2. Secondary Phone & Chalet Selection -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSecondaryPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="رقم هاتف إضافي (اختياري)"
                                     Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0" FontSize="13"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableChalets}"
                                      SelectedItem="{Binding NewSelectedChalet}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="اختر الشاليه *"
                                      Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0" FontSize="13">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#162536"/>
                                        <Setter Property="Foreground" Value="#F0F4F8"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#243447"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="شاليه " Foreground="#94A3B8" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="#60A5FA" FontSize="13.5"/>
                                            <TextBlock Text=" (" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text="{Binding ChaletType}" Foreground="#F0F4F8" FontSize="12"/>
                                            <TextBlock Text=" - " Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text="{Binding BuildingArea}" Foreground="#D4A017" FontSize="12"/>
                                            <TextBlock Text=")" Foreground="#64748B" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- 3. Dates & Duration -->
                        <TextBlock Text="مواعيد الحجز والمدة:" Foreground="#CBD5E1" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding NewCheckInDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:HintAssist.Hint="تاريخ الوصول *"
                                        Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0" FontSize="13"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding NewCheckOutDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:HintAssist.Hint="تاريخ المغادرة *"
                                        Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0" FontSize="13"/>
                            <Border Grid.Column="2" Background="#1E2D3D" CornerRadius="8" Padding="8,6" BorderBrush="#3B82F6" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="المدة" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NewNumberOfDays, StringFormat={}{0} ليالي}" FontSize="13.5" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Smart Conflict Warning and Alternative Suggestions -->
                        <Border Background="#331A05" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding ConflictNotice.Length, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ConflictNotice}" Foreground="#FCA5A5" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Suggested Alternative Chalets -->
                                <StackPanel Visibility="{Binding SuggestedChalets.Count, Converter={StaticResource BoolToVis}}" Margin="28,4,0,0">
                                    <TextBlock Text="شاليهات بديلة متاحة لنفس التواريخ (اضغط لاختيار الشاليه فوراً):" Foreground="#FDE047" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding SuggestedChalets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectSuggestedChaletCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GoldButton}" Height="30" Padding="10,2" Margin="0,0,6,6" FontSize="11.5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="HomeCheck" Width="14" Height="14" Margin="0,0,4,0"/>
                                                         <TextBlock Text="{Binding Number, StringFormat=شاليه {0}}"/>
                                                        <TextBlock Text="{Binding ChaletType, StringFormat= ({0})}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Pricing & Deposit Section -->
                        <Border Background="#1E2D3D" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="#2D3F55" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Total Rent -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="إجمالي سعر السكن للشاليه:" FontSize="12.5" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding NewChaletTotal, StringFormat={}{0:N0} ج.م}" FontSize="17" FontWeight="Bold" Foreground="#F0F4F8"/>
                                </StackPanel>

                                <!-- Deposit Input (Safe string binding, no conversion errors) -->
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewDepositText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="مبلغ العربون المدفوع (الديبوزت)"
                                         Foreground="#22C55E" Background="#111E2B" FontWeight="Bold" FontSize="14"/>

                                <!-- Deposit Date -->
                                <DatePicker Grid.Row="1" Grid.Column="0" SelectedDate="{Binding NewDepositDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            materialDesign:HintAssist.Hint="تاريخ استلام العربون"
                                            Foreground="#F0F4F8" Background="#111E2B" Margin="0,6,8,0" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- 5. Deposit Receipt Attachment Card -->
                        <Border Background="#1E2D3D" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="#D4A017" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ReceiptTextCheckOutline" Width="20" Height="20" Foreground="#D4A017" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="إرفاق صورة إيصال العربون (الديبوزت):" FontSize="13.5" FontWeight="Bold" Foreground="#D4A017" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NewDepositReceiptFileName, FallbackValue='لم يتم إرفاق صورة إيصال بعد'}" 
                                               FontSize="11.5" Foreground="#94A3B8" Margin="28,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding UploadNewDepositReceiptCommand}" Style="{StaticResource GoldButton}" Padding="12,6" Height="36" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="رفع صورة الإيصال" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ViewNewDepositReceiptCommand}"
                                            Visibility="{Binding NewHasDepositReceipt, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource SuccessButton}" Padding="10,6" Height="36" Margin="0,0,6,0" ToolTip="معاينة صورة الإيصال">
                                        <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
                                    </Button>
                                    <Button Command="{Binding RemoveNewDepositReceiptCommand}"
                                            Visibility="{Binding NewHasDepositReceipt, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource DangerButton}" Padding="8,6" Height="36" ToolTip="حذف صورة الإيصال">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 6. Notes -->
                        <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="ملاحظات الحجز (اختياري)"
                                 Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,0,20" FontSize="13"/>

                        <!-- Save / Cancel Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SaveNewReservationCommand}" Style="{StaticResource GoldButton}" Height="44" Padding="26,0" Margin="0,0,10,0" FontSize="14">
                                💾 تأكيد وحفظ الحجز المسبق
                            </Button>
                            <Button Command="{Binding CancelNewReservationCommand}" Background="#374151" Foreground="White" BorderThickness="0" Height="44" Padding="20,0" Cursor="Hand" FontSize="14">
                                إلغاء
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- OVERLAY 2: EDIT RESERVATION MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000" Background="#D9000000"
              Visibility="{Binding IsEditReservationOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#162536" CornerRadius="16" BorderBrush="#D4A017" BorderThickness="2"
                    Width="600" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="Pencil" Width="22" Height="22" Foreground="#D4A017" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تعديل بيانات وتواريخ الحجز المسبق" FontSize="18" FontWeight="Bold" Foreground="#D4A017" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedReservation.Chalet.Number, StringFormat=الشاليه: {0}}" Foreground="#60A5FA" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding EditGuestName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="اسم العميل *"
                                 Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding EditPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="رقم الهاتف الأساسي *"
                                 Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding EditSecondaryPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="رقم هاتف إضافي"
                                 Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding EditDepositText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="مبلغ العربون (الديبوزت)"
                                 Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" SelectedDate="{Binding EditCheckInDate}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    materialDesign:HintAssist.Hint="تاريخ الوصول *"
                                    Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,6,0"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding EditCheckOutDate}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    materialDesign:HintAssist.Hint="تاريخ المغادرة *"
                                    Foreground="#F0F4F8" Background="#111E2B" Margin="6,0,0,0"/>
                    </Grid>

                    <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="ملاحظات الحجز"
                             Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveEditReservationCommand}" Style="{StaticResource GoldButton}" Height="40" Padding="20,0" Margin="0,0,10,0">
                            💾 حفظ التعديلات
                        </Button>
                        <Button Command="{Binding CancelEditReservationCommand}" Background="#374151" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand">
                            إلغاء
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 3: CHANGE CHALET MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000" Background="#D9000000"
              Visibility="{Binding IsChangeChaletOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#162536" CornerRadius="16" BorderBrush="#D4A017" BorderThickness="2"
                    Width="480" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="24" Height="24" Foreground="#D4A017" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تغيير الشاليه للحجز المسبق" FontSize="18" FontWeight="Bold" Foreground="#D4A017" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedReservation.GuestName, StringFormat=العميل: {0}}" Foreground="#F0F4F8" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SelectedReservation.Chalet.Number, StringFormat=الشاليه الحالي: {0}}" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,16"/>

                    <TextBlock Text="اختر الشاليه الجديد البديل:" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableChalets}"
                              SelectedItem="{Binding SelectedNewChalet}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#F0F4F8" Background="#111E2B" Margin="0,0,0,20">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#162536"/>
                                <Setter Property="Foreground" Value="#F0F4F8"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#243447"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="شاليه " Foreground="#94A3B8" FontSize="13.5"/>
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="#60A5FA" FontSize="13.5"/>
                                    <TextBlock Text=" (" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding ChaletType}" Foreground="#F0F4F8" FontSize="12"/>
                                    <TextBlock Text=" - " Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding BuildingArea}" Foreground="#D4A017" FontSize="12"/>
                                    <TextBlock Text=")" Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ConfirmChangeChaletCommand}" Style="{StaticResource GoldButton}" Height="40" Padding="20,0" Margin="0,0,10,0">
                            تأكيد نقل الشاليه
                        </Button>
                        <Button Command="{Binding CancelChangeChaletCommand}" Background="#374151" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand">
                            إلغاء
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
