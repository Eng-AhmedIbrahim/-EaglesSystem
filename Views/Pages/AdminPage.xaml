<Page x:Class="EaglesResort.Views.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:helpers="clr-namespace:EaglesResort.Helpers"
      Title="Admin"
      Background="#111E2B"
      FlowDirection="RightToLeft"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      FontFamily="Segoe UI, Tahoma, Arial">

    <Page.Resources>
        <helpers:MonthNumberToNameConverter x:Key="MonthName"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <helpers:NullToVisibleConverter x:Key="NullToVisible"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" CanContentScroll="False">
        <Grid Margin="20">
            <TabControl Style="{StaticResource MaterialDesignTabControl}"
                        Background="Transparent"
                        Foreground="#F0F4F8">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="20,12"/>
                    </Style>
                </TabControl.Resources>

                <!-- ===== TAB 1: Monthly Rates ===== -->
                <TabItem Header="🗓️ أسعار الشاليهات">
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="أسعار الشاليهات الشهرية للمدنيين" FontSize="15" FontWeight="Bold"
                                               Foreground="#D4A017"/>
                                    <TextBlock Text="اضغط على الخلية لتعديل السعر اليومي أو سعر الوجبة" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ChaletTypes}"
                                              SelectedItem="{Binding SelectedChaletType}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Foreground="#F0F4F8" Width="200" Margin="0,0,12,0"
                                              materialDesign:HintAssist.Hint="نوع الشاليه"/>
                                    <Button Command="{Binding SaveRatesCommand}" Style="{StaticResource GoldButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,6,0"/>
                                            <TextBlock Text="حفظ الأسعار"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding MonthlyRates}"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="False" CanUserAddRows="False" AutoGenerateColumns="False"
                                      MinHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="الشهر" Width="120" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Month, Converter={StaticResource MonthName}}"
                                                           FontWeight="Bold" Foreground="#D4A017"
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="السعر اليومي (ج.م)" Binding="{Binding DailyRate, StringFormat={}{0:N0}}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="سعر وجبة البالغين (ج.م)" Binding="{Binding AdultMealRate, StringFormat={}{0:N0}}" Width="*"/>
                                    <DataGridTextColumn Header="سعر وجبة الأطفال (ج.م)" Binding="{Binding ChildMealRate, StringFormat={}{0:N0}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E"
                                       FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ===== TAB 2: Special Rates (Military) ===== -->
                <TabItem Header="🎖️ أسعار العسكريين">
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="أسعار الشاليهات للضباط والعسكريين" FontSize="15" FontWeight="Bold"
                                               Foreground="#D4A017"/>
                                    <TextBlock Text="اختار نوع الشاليه وفئة النزيل لتعديل أسعاره" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ChaletTypes}"
                                              SelectedItem="{Binding SelectedChaletType}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Foreground="#F0F4F8" Width="160" Margin="0,0,8,0"
                                              materialDesign:HintAssist.Hint="نوع الشاليه"/>
                                    <ComboBox ItemsSource="{Binding GuestCategories}"
                                              SelectedItem="{Binding SelectedGuestCategory}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Foreground="#F0F4F8" Width="250" Margin="0,0,12,0"
                                              materialDesign:HintAssist.Hint="فئة النزيل"/>
                                    <Button Command="{Binding SaveRatesCommand}" Style="{StaticResource GoldButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,6,0"/>
                                            <TextBlock Text="حفظ الأسعار"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Background="#1A2533" CornerRadius="8" Padding="16" BorderBrush="#2D3F55" BorderThickness="1" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="السعر اليومي وأسعار الوجبات" FontSize="14" FontWeight="Bold" Foreground="#D4A017" Margin="0,0,0,12"/>
                                    <DataGrid ItemsSource="{Binding SpecialRates}"
                                              Style="{StaticResource ModernDataGrid}"
                                              IsReadOnly="False" CanUserAddRows="False" AutoGenerateColumns="False"
                                              MinHeight="80">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="نوع الشاليه" Binding="{Binding ChaletType}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="فئة النزيل" Binding="{Binding GuestCategory}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="السعر اليومي (ج.م)" Binding="{Binding DailyRate, StringFormat={}{0:N0}}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="سعر وجبة البالغين (ج.م)" Binding="{Binding AdultMealRate, StringFormat={}{0:N0}}" Width="*"/>
                                            <DataGridTextColumn Header="سعر وجبة الأطفال (ج.م)" Binding="{Binding ChildMealRate, StringFormat={}{0:N0}}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E"
                                       FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ===== TAB 3: Settings ===== -->
                <TabItem Header="⚙️ الإعدادات العامة">
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: General Settings -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الإعدادات الافتراضية للنظام" FontSize="15" FontWeight="Bold"
                                           Foreground="#D4A017" Margin="0,0,0,20"/>

                                <TextBlock Text="قيمة التأمين الافتراضية (ج.م)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DefaultInsurance}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14"/>

                                <TextBlock Text="اسم مسئول الاستقبال" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ReceptionistName}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14"/>

                                <TextBlock Text="طرق الدفع (مفصولة بفاصلة ,)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding PaymentMethodsConfig}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14"
                                         materialDesign:HintAssist.Hint="مثال: كاش,فيزا,انستا باي,تحويل بنكي"/>

                                <TextBlock Text="اسم مسئول الحسابات" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AccountantName}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14"/>

                                <TextBlock Text="اسم قائد المنتجع" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ResortManagerName}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14"/>

                                <TextBlock Text="تعليمات المطعم (في الفاتورة)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RestaurantTerms}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,16" FontSize="14" TextWrapping="Wrap" MinHeight="50"/>

                                <TextBlock Text="🖨️ طابعة الفواتير (اختر الطابعة المتصلة)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinterName}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,0,24" FontSize="14"
                                          materialDesign:HintAssist.Hint="اختر الطابعة..."/>

                                <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource GoldButton}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="حفظ الإعدادات العامة"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E" FontSize="13" Margin="0,12,0,0"/>
                            </StackPanel>

                            <!-- Column 2: Chalet Types Settings -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="إدارة أنواع الشاليهات" FontSize="15" FontWeight="Bold"
                                           Foreground="#D4A017" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewChaletType, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="اسم النوع (مثال: زوجي مميز)"
                                             Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,8,0"/>
                                    <!-- Show Save/Cancel when editing, Add when not -->
                                    <Button Grid.Column="1" Command="{Binding AddChaletTypeCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingChaletType, Converter={StaticResource NullToVisible}}">
                                        إضافة
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding SaveChaletTypeEditCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingChaletType, Converter={StaticResource NullToCollapsed}}" Margin="0,0,4,0">
                                        ✔ حفظ
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CancelChaletTypeEditCommand}"
                                            Visibility="{Binding EditingChaletType, Converter={StaticResource NullToCollapsed}}"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        ✕
                                    </Button>
                                </Grid>

                                <Border Background="#1A2533" CornerRadius="8" BorderBrush="#2D3F55" BorderThickness="1" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                        <ItemsControl ItemsSource="{Binding ConfiguredChaletTypes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="#F0F4F8" FontSize="14" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.EditChaletTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Foreground="#D4A017" BorderBrush="Transparent" Padding="4" ToolTip="تعديل" Margin="0,0,4,0">
                                                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Grid.Column="2" Command="{Binding DataContext.RemoveChaletTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444" BorderBrush="Transparent" Padding="4" ToolTip="حذف">
                                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="إدارة المباني / المناطق" FontSize="15" FontWeight="Bold"
                                           Foreground="#D4A017" Margin="0,24,0,20"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewBuildingArea, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="اسم المنطقة (مثال: VIP)"
                                             Foreground="#F0F4F8" Background="#1A2533" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Command="{Binding AddBuildingAreaCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingBuildingArea, Converter={StaticResource NullToVisible}}">
                                        إضافة
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding SaveBuildingAreaEditCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingBuildingArea, Converter={StaticResource NullToCollapsed}}" Margin="0,0,4,0">
                                        ✔ حفظ
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CancelBuildingAreaEditCommand}"
                                            Visibility="{Binding EditingBuildingArea, Converter={StaticResource NullToCollapsed}}"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        ✕
                                    </Button>
                                </Grid>

                                <Border Background="#1A2533" CornerRadius="8" BorderBrush="#2D3F55" BorderThickness="1" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                        <ItemsControl ItemsSource="{Binding ConfiguredBuildingAreas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="#F0F4F8" FontSize="14" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.EditBuildingAreaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Foreground="#D4A017" BorderBrush="Transparent" Padding="4" ToolTip="تعديل" Margin="0,0,4,0">
                                                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Grid.Column="2" Command="{Binding DataContext.RemoveBuildingAreaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444" BorderBrush="Transparent" Padding="4" ToolTip="حذف">
                                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>


                <!-- ===== TAB 5: Receptionists CRUD ===== -->
                <TabItem Header="مسؤولو الاستقبال">
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="إدارة مسؤولي الاستقبال" FontSize="16" FontWeight="Bold" Foreground="#D4A017"/>
                                    <TextBlock Text="إضافة وتعديل أسماء مسؤولي الاستقبال ليتم اختيارهم عند إصدار الفاتورة" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Add / Edit Receptionist Controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding NewReceptionistName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="اسم مسؤول الاستقبال..."
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="#F0F4F8" Background="#1A2533" Width="230" Margin="0,0,10,0"
                                             FontSize="13" Padding="8,8"/>
                                    <Button Command="{Binding AddReceptionistCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingReceptionist, Converter={StaticResource NullToVisible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,6,0"/>
                                            <TextBlock Text="إضافة مسؤول"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveReceptionistEditCommand}" Style="{StaticResource GoldButton}"
                                            Visibility="{Binding EditingReceptionist, Converter={StaticResource NullToCollapsed}}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,4,0"/>
                                            <TextBlock Text="حفظ التعديل"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelReceptionistEditCommand}"
                                            Visibility="{Binding EditingReceptionist, Converter={StaticResource NullToCollapsed}}"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                        ✕
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Receptionists}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MaxHeight="450">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTemplateColumn Header="الحالة" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ToggleReceptionistActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,4" FontSize="11" Margin="2">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="Content" Value="نشط ✓"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#6B7280"/>
                                                                    <Setter Property="Foreground" Value="#D1D5DB"/>
                                                                    <Setter Property="Content" Value="معطل ✕"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="إجراءات" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Command="{Binding DataContext.EditReceptionistCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}"
                                                            Foreground="#D4A017" ToolTip="تعديل الاسم" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteReceptionistCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}"
                                                            Foreground="#EF4444" ToolTip="حذف">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Page>
