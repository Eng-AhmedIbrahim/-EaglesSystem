<Window x:Class="EaglesResort.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:EaglesResort.ViewModels"
        xmlns:helpers="clr-namespace:EaglesResort.Helpers"
        Title="Eagles Resort Matrouh - تسجيل الدخول"
        Height="720" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Icon="/Assets/logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Border CornerRadius="20" Background="#0F1923" ClipToBounds="True" RenderOptions.ClearTypeHint="Enabled">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- Background gradient -->
            <Border CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F1923" Offset="0"/>
                        <GradientStop Color="#1A2533" Offset="0.5"/>
                        <GradientStop Color="#0F1923" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Decorative circles -->
            <Ellipse Width="200" Height="200" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-60,-60,0" Opacity="0.08">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#D4A017"/>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="150" Height="150" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-40,0,0,-40" Opacity="0.05">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#D4A017"/>
                </Ellipse.Fill>
            </Ellipse>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Margin="50,20,50,20">

                    <!-- Title Bar (drag) -->
                    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown" Height="30" Margin="-50,-20,-50,20">
                        <Button HorizontalAlignment="Left" Width="30" Height="30"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#EF4444" Click="CloseButton_Click" Padding="0">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>


                    <!-- Logo -->
                    <Image Source="/Assets/logo.png" Width="240" Height="254" HorizontalAlignment="Center" Margin="0,0,0,4"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.748,0.655">
                        <Image.Effect>
                            <DropShadowEffect Color="#D4A017" BlurRadius="20" Opacity="0.3" ShadowDepth="0"/>
                        </Image.Effect>
                    </Image>

                    <Separator Margin="0,12,0,12" Background="#2D3F55"/>

                    <!-- Login Title -->
                    <TextBlock Text="تسجيل الدخول" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#F0F4F8" Margin="0,0,0,24"/>

                    <!-- Username -->
                    <TextBox x:Name="UsernameBox"
                         materialDesign:HintAssist.Hint="أدخل اسم المستخدم"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#F0F4F8" CaretBrush="#D4A017"
                         materialDesign:TextFieldAssist.UnderlineBrush="#D4A017"
                         Background="#1A2533"
                         Margin="0,0,0,16" FontSize="14"
                         KeyDown="Input_KeyDown"/>

                    <!-- Password -->
                    <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="أدخل كلمة المرور"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="#F0F4F8" CaretBrush="#D4A017"
                             Background="#1A2533"
                             Margin="0,0,0,8" FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="Input_KeyDown"/>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                           FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}"
                        Style="{StaticResource GoldButton}"
                        FontSize="16" Padding="0,12"
                        HorizontalAlignment="Stretch" Margin="0,0,0,16"
                        IsEnabled="{Binding IsNotLoading}" Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="دخول"/>
                        </StackPanel>
                    </Button>

                    <!-- Loading indicator -->
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,8"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Foreground="#D4A017"/>

                    <TextBlock Text="المستخدم الافتراضي: admin | كلمة المرور: admin123"
                           Foreground="#4A5568" FontSize="10" HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
