<Window x:Class="EaglesResort.Views.Windows.TodayCheckoutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="مغادرة اليوم" Height="700" Width="1000"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png">
    <Border Background="#111E2B" CornerRadius="12" BorderBrush="#2D3F55" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Background="#0A1420" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo and Title -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="40" Height="40" Margin="0,0,12,0"/>
                        <materialDesign:PackIcon Kind="ExitRun" Width="24" Height="24" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="مغادرة اليوم" FontSize="20" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" Click="CloseButton_Click" Padding="4" Width="40" Height="40" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1" Margin="20">
                <DataGrid ItemsSource="{Binding TodayCheckouts}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="150"/>
                        <DataGridTextColumn Header="الشاليه" Binding="{Binding Chalet.Number}" Width="70"/>
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="نظام الدفع" Binding="{Binding PaymentSystem}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الوصول" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ المغادرة" Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="تسجيل المغادرة"
                                            Command="{Binding DataContext.CheckoutBookingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            FontSize="14" Padding="12,6"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
