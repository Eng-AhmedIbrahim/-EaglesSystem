<Window x:Class="EaglesResort.Views.Windows.TodayBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:EaglesResort.Helpers"
        Title="حجوزات ووصول اليوم" Height="750" Width="1200"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <helpers:BookingStatusToColorConverter x:Key="BookingStatusColor"/>
        <helpers:BookingStatusToArabicConverter x:Key="BookingStatusArabic"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2D3D"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3F55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#111E2B" CornerRadius="14" BorderBrush="#2D3F55" BorderThickness="1.5" ClipToBounds="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="#0A1420" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="36" Height="36" Margin="0,0,12,0"/>
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="24" Height="24" Foreground="#D4A017" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="حجوزات ووصول اليوم" FontSize="20" FontWeight="Bold" Foreground="#D4A017" VerticalAlignment="Center"/>
                        <Border Background="#1E3A5F" CornerRadius="12" Padding="12,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TodayArrivalsCount, StringFormat=وصول اليوم: {0} حجز}" FontSize="12.5" Foreground="#60A5FA" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignToolButton}" Foreground="#94A3B8" Click="MinimizeButton_Click" Padding="8" Margin="0,0,4,0" ToolTip="تصغير">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}" Foreground="#94A3B8" Click="MaximizeButton_Click" Padding="8" Margin="0,0,4,0" ToolTip="تكبير / استعادة">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}" Foreground="#EF4444" Click="CloseButton_Click" Padding="8" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Status Banner -->
            <Border Grid.Row="1" Background="#162536" Padding="16,8" Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#F0C040" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Border>

            <!-- 3. Filter Tabs Bar -->
            <Border Grid.Row="2" Background="#162536" Padding="18,10" BorderBrush="#2D3F55" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab 0: وصول اليوم -->
                    <Button Command="{Binding SetFilterTabCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilterTab}" Value="0">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="📅 وصول اليوم" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding TodayArrivalsCount}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 1: الحجوزات القادمة -->
                    <Button Command="{Binding SetFilterTabCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilterTab}" Value="1">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="⏳ الحجوزات القادمة" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding UpcomingCount}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 2: تم التسكين -->
                    <Button Command="{Binding SetFilterTabCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilterTab}" Value="2">
                                        <Setter Property="Background" Value="#16A34A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🏨 تم التسكين" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding CheckedInCount}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tab 3: كل الحجوزات -->
                    <Button Command="{Binding SetFilterTabCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveFilterTab}" Value="3">
                                        <Setter Property="Background" Value="#4B5563"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="📁 كل الحجوزات" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" Opacity="0.25" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding AllActiveCount}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 4. Main DataGrid & Empty State -->
            <Grid Grid.Row="3" Margin="16">
                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding TodayBookings}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>

                        <DataGridTemplateColumn Header="النزيل" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GuestName}" FontWeight="Bold" Foreground="#F0F4F8" FontSize="13"/>
                                        <TextBlock Text="{Binding GuestRank}" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الموبايل" Binding="{Binding PhoneNumber}" Width="120"/>

                        <DataGridTemplateColumn Header="الشاليه" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2D3D" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                            <TextBlock Text="{Binding Chalet.Number, StringFormat=({0})}" FontWeight="Bold" Foreground="#60A5FA"/>
                                            <TextBlock Text="{Binding Chalet.ChaletType}" FontSize="10.5" Foreground="#94A3B8" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الوصول" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="95"/>
                        <DataGridTextColumn Header="المغادرة" Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" Width="95"/>
                        <DataGridTextColumn Header="المدة" Binding="{Binding NumberOfDays, StringFormat={}{0} يوم}" Width="65"/>

                        <!-- Deposit & Receipt -->
                        <DataGridTemplateColumn Header="العربون (الديبوزت)" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Deposit, StringFormat={}{0:N0} ج.م}" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <!-- View receipt button -->
                                        <Button Command="{Binding DataContext.ViewDepositReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#38BDF8" BorderBrush="#38BDF8" Padding="6,2" Height="26" FontSize="11" ToolTip="معاينة إيصال العربون" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="ReceiptText" Width="14" Height="14"/>
                                        </Button>
                                        <!-- Upload/replace receipt -->
                                        <Button Command="{Binding DataContext.UploadDepositReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#D4A017" BorderBrush="#D4A017" Padding="6,2" Height="26" FontSize="11" ToolTip="رفع أو تغيير إيصال العربون">
                                            <materialDesign:PackIcon Kind="Upload" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="الحالة" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource BookingStatusColor}}"
                                            CornerRadius="4" Padding="6,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource BookingStatusArabic}}"
                                                   FontSize="11.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Instant CheckIn Button -->
                                        <Button Command="{Binding DataContext.InstantCheckInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SuccessButton}"
                                                Padding="10,4" FontSize="11.5" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Key" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="تسكين الآن"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Change Chalet Button -->
                                        <Button Command="{Binding DataContext.OpenChangeChaletCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#60A5FA" BorderBrush="#60A5FA"
                                                Padding="8,4" FontSize="11.5" Margin="0,0,6,0" ToolTip="تغيير الشاليه لهذا الحجز">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="تغيير الشاليه"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Edit Booking Button -->
                                        <Button Command="{Binding DataContext.OpenEditBookingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#D4A017" BorderBrush="#D4A017"
                                                Padding="8,4" FontSize="11.5" ToolTip="تعديل تفاصيل وتواريخ الحجز">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="تعديل"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Placeholder -->
                <Border Background="#162536" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#2D3F55" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TodayBookings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="48" Height="48" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="لا توجد حجوزات مسجلة في هذا التبويب" FontSize="16" FontWeight="Bold" Foreground="#F0F4F8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="يمكنك استعراض التبويبات الأخرى (الحجوزات القادمة، تم التسكين، كل الحجوزات) من الأعلى" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Overlay 1: Change Chalet Modal -->
                <Grid Background="#CC000000" Visibility="{Binding IsChangeChaletOpen, Converter={StaticResource BoolToVis}}">
                    <Border Background="#1A2533" CornerRadius="12" BorderBrush="#D4A017" BorderThickness="1.5"
                            Width="440" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="22" Height="22" Foreground="#D4A017" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تغيير الشاليه للحجز" FontSize="17" FontWeight="Bold" Foreground="#D4A017" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedBooking.GuestName, StringFormat=النزيل: {0}}" Foreground="#F0F4F8" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedBooking.Chalet.Number, StringFormat=الشاليه الحالي: {0}}" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,14"/>

                            <TextBlock Text="اختر الشاليه الجديد البديل:" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailableChalets}"
                                      SelectedItem="{Binding SelectedNewChalet}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Foreground="#F0F4F8" Background="#0F1923" Margin="0,0,0,20">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Number, StringFormat=شاليه رقم {0}}" Foreground="#F0F4F8"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding ConfirmChangeChaletCommand}" Style="{StaticResource GoldButton}" Padding="16,8" Margin="0,0,10,0">
                                    تأكيد النقل
                                </Button>
                                <Button Command="{Binding CancelChangeChaletCommand}" Style="{StaticResource DangerButton}" Padding="14,8">
                                    إلغاء
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Overlay 2: Edit Booking Modal -->
                <Grid Background="#CC000000" Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}}">
                    <Border Background="#1A2533" CornerRadius="12" BorderBrush="#60A5FA" BorderThickness="1.5"
                            Width="480" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="Pencil" Width="22" Height="22" Foreground="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل بيانات وتواريخ الحجز" FontSize="17" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="اسم النزيل:" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditGuestName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="#F0F4F8" Background="#0F1923" Margin="0,0,0,10"/>

                            <TextBlock Text="رقم الموبايل:" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="#F0F4F8" Background="#0F1923" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تاريخ الوصول:" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditCheckInDate}" Language="ar-EG" Foreground="#F0F4F8" Background="#0F1923"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ المغادرة:" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditCheckOutDate}" Language="ar-EG" Foreground="#F0F4F8" Background="#0F1923"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="العربون (الديبوزت):" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDepositText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="#F0F4F8" Background="#0F1923" Margin="0,0,0,10"/>

                            <TextBlock Text="ملاحظات:" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="#F0F4F8" Background="#0F1923" Margin="0,0,0,18"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding SaveEditBookingCommand}" Style="{StaticResource GoldButton}" Padding="16,8" Margin="0,0,10,0">
                                    حفظ التعديلات
                                </Button>
                                <Button Command="{Binding CancelEditBookingCommand}" Style="{StaticResource DangerButton}" Padding="14,8">
                                    إلغاء
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
