<Window x:Class="EaglesResort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:EaglesResort.Views"
        Title="Eagles Resort Matrouh - نظام إدارة المنتجع"
        Height="800" Width="1300"
        MinHeight="700" MinWidth="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Language="ar-EG"
        Background="Transparent"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Icon="/Assets/logo.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2533"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#243447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" Background="#0F1923" ClipToBounds="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================== SIDEBAR ======================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#0A1420" CornerRadius="16,0,0,16">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                        <Image Source="/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center">
                            <Image.Effect>
                                <DropShadowEffect Color="#D4A017" ShadowDepth="0" BlurRadius="5" Opacity="0.8"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="Eagles Resort" FontSize="15" FontWeight="Bold"
                                   Foreground="#D4A017" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        <TextBlock Text="MATROUH" FontSize="9" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI" FontWeight="Light"/>

                        <!-- User info -->
                        <Border Background="#1A2533" CornerRadius="10" Padding="10,8" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="22" Height="22"
                                                         Foreground="#D4A017" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="UserNameText" Text="Admin" FontSize="12"
                                               Foreground="#F0F4F8" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UserRoleText" Text="مدير النظام" FontSize="10"
                                               Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator DockPanel.Dock="Top" Background="#1E2D3D" Margin="16,0"/>

                    <!-- Navigation Items -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,8">
                        <Button x:Name="NavTimeline" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavTimeline_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="لوحة التحكم والجدول الزمني" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavChalets" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavChalets_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="دليل الشاليهات" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavBooking" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavBooking_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="الفاتورة" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavReservations" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavReservations_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarCheck" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="سجل الحجوزات" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavGuests" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavGuests_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="سجل العملاء" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavUsers" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavUsers_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountKey" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="إدارة المستخدمين" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAdmin" Style="{StaticResource SidebarButtonStyle}"
                                Click="NavAdmin_Click" HorizontalAlignment="Stretch" Padding="12,14"
                                HorizontalContentAlignment="Left" Foreground="#F0F4F8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,12,0"/>
                                <TextBlock Text="الإعدادات والإدارة" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom: Logout & Close -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                        <Separator Background="#1E2D3D" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CurrentDateText" FontSize="11" Foreground="#4A5568"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="Logout_Click" HorizontalAlignment="Stretch"
                                Foreground="#EF4444" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="تسجيل الخروج" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="Close_Click" HorizontalAlignment="Stretch"
                                Foreground="#94A3B8" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="إغلاق البرنامج" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======================== CONTENT AREA ======================== -->
            <Border Grid.Column="1" Background="#111E2B">
                <DockPanel>
                    <!-- Top Bar -->
                    <Border DockPanel.Dock="Top" Background="#0A1420" Padding="20,12"
                            MouseLeftButtonDown="TopBar_MouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Title -->
                            <!-- Title & Sidebar Toggle -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <Button x:Name="SidebarToggleButton" Style="{StaticResource MaterialDesignToolButton}"
                                        Click="ToggleSidebar_Click" Foreground="#D4A017" Padding="6" Margin="0,0,14,0"
                                        ToolTip="إخفاء / إظهار القائمة الجانبية لتكبير الشاشة">
                                    <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"/>
                                </Button>
                                <TextBlock x:Name="PageTitle" Text="لوحة التحكم والجدول الزمني"
                                           FontSize="18" FontWeight="Bold" Foreground="#D4A017"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Window Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource MaterialDesignToolButton}"
                                        Click="MinimizeButton_Click" Foreground="#94A3B8" Padding="12,8">
                                    <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignToolButton}"
                                        Click="MaximizeButton_Click" Foreground="#94A3B8" Padding="12,8">
                                    <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignToolButton}"
                                        Click="CloseButton_Click" Foreground="#EF4444" Padding="12,8">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content Area with Transitions & Loading Overlay -->
                    <Grid>
                        <!-- Pages Frame -->
                        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
                               Background="Transparent"
                               Navigating="MainFrame_Navigating"
                               Navigated="MainFrame_Navigated"/>

                        <!-- Sleek Loading Indicator Overlay -->
                        <Grid x:Name="NavigationLoadingOverlay" Background="#600A1420" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="#162536" CornerRadius="16" BorderBrush="#D4A017" BorderThickness="1.5"
                                    Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Value="0" IsIndeterminate="True"
                                                 Width="24" Height="24" Foreground="#D4A017" Margin="0,0,12,0"/>
                                    <TextBlock Text="جاري تحميل الصفحة..." FontSize="14" FontWeight="Bold" Foreground="#F0F4F8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
